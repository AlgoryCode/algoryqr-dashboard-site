{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard-local-8055",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "cross-env",
        "API_BASE_URL=http://localhost:8055",
        "AUTH_BASE_URL=http://localhost:8055",
        "PUBLIC_API_BASE_URL=http://localhost:8055",
        "next",
        "dev",
        "--port",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "menu-site-local-8055",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd ../qr-menu-site && API_BASE_URL=http://localhost:8055 PUBLIC_API_BASE_URL=http://localhost:8055 MENU_PUBLIC_PATH_STRIP=1 npx next dev --port 3010"
      ],
      "port": 3010
    }
  ]
}
