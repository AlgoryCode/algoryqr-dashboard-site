  "turns": [
    {
      "id": "agent-reads-menu-dessert",
      "userQuery": "Tatlı ne var",
      "agentProductIds": [101, 102],
      "expect": {
        "kind": "agent",
        "mustIncludeProductIds": [101, 102],
        "mustNotIncludeProductIds": [401, 201],
        "minCount": 2
      }
    },
    {
      "id": "agent-reads-menu-fish",
      "userQuery": "Balık ne var",
      "agentProductIds": [201],
      "expect": {
        "kind": "agent",
        "mustIncludeProductIds": [201],
        "mustNotIncludeProductIds": [101, 111],
        "minCount": 1
      }
    },
    {
      "id": "bff-keeps-agent-not-rewriting",
      "userQuery": "Tatlı öner",
      "agentProductIds": [101],
      "expect": {
        "kind": "agent",
        "mustIncludeProductIds": [101],
        "maxCount": 1
      }
    },
    {
      "id": "menu-text-fallback-when-agent-empty",
      "userQuery": "Tatlılar",
      "agentProductIds": [],
      "expect": {
        "kind": "category",
        "mustIncludeProductIds": [111, 112],
        "minCount": 2
      }
    },
    {
      "id": "no-lexicon-when-menu-has-no-matching-text",
      "userQuery": "Sushi öner",
      "agentProductIds": [],
      "expect": {
        "kind": "none",
        "maxCount": 0
      }
    },
    {
      "id": "product-name-on-this-menu",
      "userQuery": "Baklava",
      "agentProductIds": [],
      "expect": {
        "kind": "product",
        "mustIncludeProductIds": [101],
        "minCount": 1
      }
    },
    {
      "id": "pairing-uses-menu-product-name",
      "userQuery": "Baklava yanında ne önerirsin",
      "agentProductIds": [101],
      "expect": {
        "pairing": true,
        "mustNotIncludeProductIds": [101],
        "minCount": 1
      }
    }
  ]
}
