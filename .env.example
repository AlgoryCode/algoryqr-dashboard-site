# Copy to .env.local for local dev only.
# Production/stage: set everything in Coolify (not in the Docker image).

# --- Coolify: Build Environment (required for NEXT_PUBLIC_* at npm run build) ---
# Menüyü aç ve menü QR hedefi kod içinde sabit olarak https://qr.algorycode.com kullanır.
# NEXT_PUBLIC_STAFF_SITE_ORIGIN=https://...
# NEXT_PUBLIC_STORE_APP_ORIGIN=https://...
# NEXT_PUBLIC_MARKETING_APP_ORIGIN=https://qr.algorycode.com
# Optional at build if you need them in client bundle:
# NEXT_PUBLIC_APP_URL=https://dashboard.algorycode.com
# API_BASE_URL=https://prod.qrapi.algorycode.com
# APP_ENV=production

# --- Coolify: Runtime Environment (server / API routes) ---
API_BASE_URL=http://localhost:8080
AUTH_BASE_URL=http://localhost:8080
PUBLIC_API_BASE_URL=http://localhost:8080
APP_URL=http://localhost:3000
APP_ENV=development
DEPLOY_ENV=

# MENU_APP_ORIGIN and NEXT_PUBLIC_MENU_APP_ORIGIN are intentionally ignored.
# Personel (garson, mutfak, kurye) ayrı sitede çalışır.
NEXT_PUBLIC_STAFF_SITE_ORIGIN=http://localhost:3001
NEXT_PUBLIC_STORE_APP_ORIGIN=http://localhost:3006
NEXT_PUBLIC_MARKETING_APP_ORIGIN=http://localhost:3000

PRODUCT_SERVICE_BASE_URL=https://stage.production.algorycode.com
PRODUCT_SERVICE_AUTH_TOKEN=
PRODUCT_SERVICE_AUTH_HEADER=X-Service-Token

# QR_MCP_BASE_URL=
# QR_MCP_API_KEY=
# QR_AGENT_BASE_URL=
# AI_SERVICE_BASE_URL=
# AI_SERVICE_API_KEY=
